<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissao normal: concedida na instalacao, permite limpar processos em cache. -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Acesso especial: o usuario ativa em Configuracoes > Apps > Acesso especial >
         Uso de apps. Sem ADB e sem root; o app funciona sem ele, com menos inteligencia. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Lista apenas apps com tela de lancador (candidatos a limpeza). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HyperG96">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DevOptionsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:label="@string/dev_options_title" />

        <activity
            android:name=".CompatActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:label="@string/compat_title" />
    </application>
</manifest>
